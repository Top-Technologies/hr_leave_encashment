<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Encashment Rules -->
        <record id="rule_encashment_own" model="ir.rule">
            <field name="name">Encashment: own records</field>
            <field name="model_id" ref="model_hr_leave_encashment"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_encashment_officer" model="ir.rule">
            <field name="name">Encashment: Time Off officers see all</field>
            <field name="model_id" ref="model_hr_leave_encashment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
        </record>

        <record id="rule_encashment_company" model="ir.rule">
            <field name="name">Encashment: multi-company</field>
            <field name="model_id" ref="model_hr_leave_encashment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Expiry Log Rules -->
        <record id="rule_expiry_log_own" model="ir.rule">
            <field name="name">Expired Leave Log: own records</field>
            <field name="model_id" ref="model_hr_leave_expiry_log"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_expiry_log_officer" model="ir.rule">
            <field name="name">Expired Leave Log: Time Off officers see all</field>
            <field name="model_id" ref="model_hr_leave_expiry_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
        </record>

        <record id="rule_expiry_log_company" model="ir.rule">
            <field name="name">Expired Leave Log: multi-company</field>
            <field name="model_id" ref="model_hr_leave_expiry_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- FIFO Consumption Rules -->
        <record id="rule_consumption_own" model="ir.rule">
            <field name="name">FIFO Consumption: own records</field>
            <field name="model_id" ref="model_hr_leave_allocation_consumption"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_consumption_officer" model="ir.rule">
            <field name="name">FIFO Consumption: Time Off officers see all</field>
            <field name="model_id" ref="model_hr_leave_allocation_consumption"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
        </record>

        <record id="rule_consumption_company" model="ir.rule">
            <field name="name">FIFO Consumption: multi-company</field>
            <field name="model_id" ref="model_hr_leave_allocation_consumption"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
