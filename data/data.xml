<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_leave_encashment" model="ir.sequence">
            <field name="name">Leave Encashment</field>
            <field name="code">hr.leave.encashment</field>
            <field name="prefix">ENC/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="input_type_leave_encashment" model="hr.payslip.input.type">
            <field name="name">Leave Encashment</field>
            <field name="code">LEAVE_ENC</field>
            <field name="struct_ids" eval="[(4, ref('hr_payroll.structure_002'))]"/>
        </record>

        <record id="hr_payroll.structure_002" model="hr.payroll.structure">
            <field name="input_line_type_ids" eval="[(4, ref('input_type_leave_encashment'))]"/>
        </record>

        <record id="rule_leave_encashment" model="hr.salary.rule">
            <field name="name">Leave Encashment</field>
            <field name="code">LEAVE_ENC</field>
            <field name="sequence">190</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="struct_id" ref="hr_payroll.structure_002"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'LEAVE_ENC' in inputs and inputs['LEAVE_ENC'].amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs['LEAVE_ENC'].amount</field>
        </record>
    </data>
</odoo>
