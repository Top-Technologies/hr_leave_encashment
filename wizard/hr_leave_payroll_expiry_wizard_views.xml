<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_payroll_expiry_wizard_form" model="ir.ui.view">
        <field name="name">hr.leave.payroll.expiry.wizard.form</field>
        <field name="model">hr.leave.payroll.expiry.wizard</field>
        <field name="arch" type="xml">
            <form string="Expire Unpaid Encashment">
                <div class="alert alert-warning mb-3" role="alert">
                    <strong>Notice:</strong> Expiring this encashment will set its payable amount to zero and mark its payroll status as Expired.
                    The original amount will be preserved for audit history.
                </div>
                <group>
                    <group string="Encashment Information">
                        <field name="employee_id"/>
                        <field name="holiday_status_id"/>
                        <field name="days_to_encash"/>
                        <field name="amount" decoration-bf="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Payroll Linkage">
                        <field name="payslip_id"/>
                        <field name="payroll_status" widget="badge"/>
                    </group>
                </group>
                <group string="HR Justification">
                    <field name="expiry_reason" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm_expiry" string="Expire Encashment" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_leave_payroll_expiry_wizard" model="ir.actions.act_window">
        <field name="name">Expire Unpaid Encashment</field>
        <field name="res_model">hr.leave.payroll.expiry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
